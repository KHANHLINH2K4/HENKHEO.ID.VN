# Copy thành .env (cùng thư mục docker-compose.yml). KHÔNG commit.
PORT=5000
APP_TIMEZONE=Asia/Ho_Chi_Minh
DB_NAME=henkheo
# Mật khẩu tài khoản sa của SQL Server (chỉ dùng cho migration): >=8 ký tự, có chữ hoa, chữ thường, số, ký tự đặc biệt.
# BẮT BUỘC đổi: ứng dụng từ chối khởi động ở production nếu còn mật khẩu mẫu.
DB_PASSWORD=ChangeMe_Strong#2026
# Tài khoản ít quyền cho ứng dụng (khuyến nghị): chỉ đọc/ghi dữ liệu, không sửa được cấu trúc bảng.
APP_DB_USER=henkheo_app
APP_DB_PASSWORD=
# Mở cổng ra ngoài: mặc định chỉ localhost (đi qua Caddy/Nginx). Đặt 0.0.0.0 nếu không dùng reverse proxy.
APP_BIND=127.0.0.1
# Tên miền cho HTTPS tự động (docker compose --profile https up -d)
DOMAIN=ten-mien-cua-ban
TRUST_PROXY=1
BUSINESS_OPEN_TIME=08:00
BUSINESS_CLOSE_TIME=18:00
DB_ENCRYPT=false
DB_TRUST_CERT=true
JWT_SECRET=
JWT_EXPIRES_IN=1d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BOOKING_MIN_LEAD_MINUTES=30
BOOKING_MAX_ADVANCE_DAYS=60
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PAYMENT_EXPIRE_MINUTES=15
APP_WEB_URL=https://ten-mien-cua-ban
PAYOS_RETURN_URL=https://ten-mien-cua-ban/
PAYOS_CANCEL_URL=https://ten-mien-cua-ban/
PAYOS_WEBHOOK_URL=https://ten-mien-cua-ban/api/payments/payos/webhook
