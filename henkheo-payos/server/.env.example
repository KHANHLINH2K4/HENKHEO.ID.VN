# ============================================================
# HẸN KHÉO — cấu hình server  (copy thành server/.env, KHÔNG commit)
# ============================================================
NODE_ENV=development            # production khi triển khai thật
PORT=5000
APP_TIMEZONE=Asia/Ho_Chi_Minh   # múi giờ nghiệp vụ (giờ đặt lịch, thống kê theo ngày)

# ---- SQL Server ----
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=                    # vd SQLEXPRESS (để trống nếu dùng cổng 1433)
DB_NAME=henkheo
DB_USER=henkheo_user
DB_PASSWORD=ChangeMe_Strong#2026
DB_ENCRYPT=false                # true khi SQL Server ở xa / Azure SQL
DB_TRUST_CERT=true

# ---- Bảo mật ----
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Production: liệt kê origin của giao diện, phân tách bằng dấu phẩy. Để trống nếu server phục vụ luôn giao diện.
CORS_ORIGIN=

# ---- Tài khoản ADMIN đầu tiên (npm run seed:admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                 # để trống = tự sinh mật khẩu ngẫu nhiên và in ra một lần

# ---- Quy tắc đặt lịch ----
BOOKING_MIN_LEAD_MINUTES=30     # phải đặt trước giờ hẹn tối thiểu bao nhiêu phút
BOOKING_MAX_ADVANCE_DAYS=60     # chỉ nhận đặt trước tối đa bao nhiêu ngày
SLOT_BUFFER_MINUTES=0           # thời gian đệm (dọn dẹp) giữa 2 lịch liên tiếp của cùng nhân viên
BUSINESS_OPEN_TIME=08:00        # giờ mở cửa chung (HH:MM): không nhận lịch bắt đầu sớm hơn
BUSINESS_CLOSE_TIME=18:00       # giờ đóng cửa chung: lịch phải KẾT THÚC trước giờ này
SLOT_STEP_MINUTES=30            # bước chia khung giờ (tối thiểu 5)
NO_SHOW_AFTER_MINUTES=0         # chỉ cho đánh dấu "không đến" sau giờ hẹn N phút

# ---- Chính sách hủy / đổi / chống chiếm giờ ảo ----
CANCEL_MIN_HOURS=2              # lịch đã xác nhận/đã trả tiền: khách chỉ tự hủy được trước giờ hẹn tối thiểu N giờ
RESCHEDULE_MIN_HOURS=2          # tương tự cho yêu cầu đổi lịch
MAX_ACTIVE_BOOKINGS=3           # số lịch chờ/sắp tới tối đa mỗi khách được giữ cùng lúc
NO_SHOW_BLOCK_COUNT=3           # khách "không đến" từ N lần ...
NO_SHOW_WINDOW_DAYS=90          # ... trong M ngày gần nhất sẽ bị tạm khóa đặt online
STORE_PENDING_EXPIRE_MINUTES=720  # lịch "trả tại cơ sở" chưa được xác nhận sau N phút sẽ tự hủy (720 = 12 giờ)

# ---- Email (tùy chọn): xác nhận đặt lịch, nhắc lịch, quên mật khẩu ----
# Để trống SMTP_HOST = tắt gửi email (dev: nội dung email được in ra console, link đặt lại mật khẩu vẫn dùng được)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true nếu dùng cổng 465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hẹn Khéo <no-reply@ten-mien-cua-ban>
BRAND_NAME=Hẹn Khéo
REMINDER_HOURS_BEFORE=24        # nhắc lịch trước giờ hẹn N giờ

# ---- payOS (thanh toán online) ----
# Lấy 3 giá trị từ kênh thanh toán tại https://my.payos.vn ; để trống = tắt thanh toán online
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PARTNER_CODE=
PAYOS_PAYMENT_EXPIRE_MINUTES=15
# Địa chỉ giao diện người dùng thấy (không có dấu / ở cuối). Dev: http://localhost:5173 ; Production: https://ten-mien-cua-ban
APP_WEB_URL=http://localhost:5173
PAYOS_RETURN_URL=http://localhost:5173/
PAYOS_CANCEL_URL=http://localhost:5173/
# Phải là HTTPS công khai (dev: dùng cloudflared/ngrok trỏ về cổng 5000)
PAYOS_WEBHOOK_URL=https://ten-mien-cua-ban/api/payments/payos/webhook

# ---- Vận hành ----
TRUST_PROXY=1                   # số lớp reverse proxy tin cậy (Nginx=1, Cloudflare+Nginx=2, chạy trực tiếp=0)
ENABLE_BACKGROUND_JOBS=true     # false = instance này không chạy việc nền (khi chạy nhiều instance, chỉ cần 1 nơi chạy)
ALLOW_MISSING_SLOT_INDEX=false  # true = cho phép khởi động dù thiếu chỉ mục chống trùng giờ (KHÔNG khuyến nghị)
CHAT_RETENTION_DAYS=180         # xóa lịch sử chatbot cũ hơn N ngày
NOTIFICATION_RETENTION_DAYS=180 # xóa thông báo ĐÃ ĐỌC cũ hơn N ngày
MAIL_RETRIES=2                  # số lần thử lại khi gửi email lỗi tạm thời
MAIL_RETRY_DELAY_MS=1000

# ---- Tài khoản CSDL ít quyền cho ứng dụng (khuyến nghị cho production) ----
# Để trống = dùng DB_USER. Điền cả hai rồi chạy `npm run db:migrate` bằng tài khoản quản trị: script tự tạo user chỉ đọc/ghi,
# sau đó đổi DB_USER/DB_PASSWORD của server sang giá trị này.
APP_DB_USER=
APP_DB_PASSWORD=
