{
  "name": "henkheo-server",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "db:migrate": "node migrate.js",
    "db:seed": "node migrate.js --seed",
    "seed:admin": "node seed-admin.js",
    "test": "node --test --test-force-exit tests/*.test.js",
    "nlp:eval": "node nlp_eval.js",
    "test:integration": "RUN_INTEGRATION=1 node --test tests/integration/",
    "lint": "eslint ."
  },
  "dependencies": {
    "@payos/node": "^2.0.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "nodemailer": "^10.2.1",
    "socket.io": "^4.8.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
